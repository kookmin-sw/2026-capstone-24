# .env.aws-dev.example — EC2 control-plane (spring + mariadb) 환경변수 템플릿.
# 사용법: EC2 인스턴스에서 cp .env.aws-dev.example ~/.env.aws-dev 후 값을 채우고,
# `docker compose -f docker-compose.ec2-dev.yml --env-file ~/.env.aws-dev up -d`.
# 경고: 실제 값은 git 에 커밋하지 않는다.

# ── MariaDB (EC2 로컬 볼륨, 외부 비공개) ─────────────────────────────────────
MARIADB_DATABASE=murang
MARIADB_USER=murang_app
MARIADB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
MARIADB_ROOT_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# ── Spring 보안 ──────────────────────────────────────────────────────────────
# openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_64_BYTES_RANDOM_SECRET

# ── Meta verifier (aws-dev 는 기본 real) ─────────────────────────────────────
MURANG_META_VERIFIER_MODE=real
MURANG_META_APP_ID=REPLACE_WITH_META_APP_ID
MURANG_META_APP_SECRET=REPLACE_WITH_META_APP_SECRET
MURANG_META_GRAPH_BASE_URL=https://graph.oculus.com

# ── Room internal callback ──────────────────────────────────────────────────
# Fargate task -> EC2 Spring 의 ready/heartbeat 콜백 베이스 URL.
# EC2 public DNS 또는 Elastic IP. 예: http://ec2-13-xxx-xxx-xxx.ap-northeast-2.compute.amazonaws.com:8080
MURANG_ROOM_INTERNAL_CALLBACK_BASE_URL=REPLACE_WITH_EC2_PUBLIC_BASE_URL
# X-Internal-Token 헤더 공유 비밀. openssl rand -hex 32.
MURANG_ROOM_INTERNAL_CALLBACK_SHARED_SECRET=REPLACE_WITH_RANDOM_HEX_SECRET

# ── ECS Fargate room-server runtime ─────────────────────────────────────────
MURANG_ROOM_RUNTIME_ECS_REGION=ap-northeast-2
MURANG_ROOM_RUNTIME_ECS_CLUSTER=REPLACE_WITH_ECS_CLUSTER_NAME
MURANG_ROOM_RUNTIME_ECS_TASK_DEFINITION_FAMILY=REPLACE_WITH_TASK_DEFINITION_FAMILY
# 쉼표 구분 — public subnet 권장.
MURANG_ROOM_RUNTIME_ECS_SUBNET_IDS=subnet-xxxxxxx,subnet-yyyyyyy
MURANG_ROOM_RUNTIME_ECS_SECURITY_GROUP_IDS=sg-xxxxxxx
MURANG_ROOM_RUNTIME_ECS_CONTAINER_NAME=room-server
MURANG_ROOM_RUNTIME_ECS_ASSIGN_PUBLIC_IP=true

# ── CloudWatch Logs (Spring stdout/stderr 송출) ─────────────────────────────
# 기본값 그대로 두면 ap-northeast-2 / `/ec2/murang-spring` 사용.
# log group 은 compose 의 `awslogs-create-group: "true"` 옵션으로 자동 생성된다.
MURANG_AWS_REGION=ap-northeast-2
MURANG_SPRING_LOG_GROUP=/ec2/murang-spring
