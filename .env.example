# .env.example — docker-compose 로컬 스택 환경변수 템플릿
# 사용법: cp .env.example .env 후 각 값을 채워넣는다.
# 경고: .env (실제 값)는 절대 git에 커밋하지 말 것. .gitignore에 이미 추가되어 있다.

# ── MariaDB ──────────────────────────────────────────────────────────────────
MARIADB_DATABASE=murang
MARIADB_USER=murang_app
MARIADB_PASSWORD=change-me-local
MARIADB_ROOT_PASSWORD=change-me-root

# ── Spring ───────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# JWT secret: Base64 인코딩된 최소 64바이트 랜덤 문자열
# 생성 예시: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_64_BYTES_RANDOM_SECRET_DO_NOT_USE_THIS_VALUE

# Meta 토큰 mock 접두어 (verifier-mode=mock 시 이 접두어가 붙은 토큰을 통과시킴)
MURANG_META_MOCK_PREFIX=mock-meta:

# Meta verifier 모드: mock (개발용) 또는 real (Quest 실기기)
# real 모드에서는 Oculus Graph API로 실제 토큰을 검증한다.
MURANG_META_VERIFIER_MODE=mock

# Meta App ID / App Secret — Meta Developer Dashboard에서 발급
# real 모드에서만 필수. mock 모드에서는 비워도 된다.
# 경고: 절대 실제 값을 git에 커밋하지 말 것.
MURANG_META_APP_ID=YOUR_META_APP_ID_HERE
MURANG_META_APP_SECRET=YOUR_META_APP_SECRET_HERE
