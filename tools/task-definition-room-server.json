{
  "family": "murang-room-server",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "room-server",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/murang-room-server:<IMAGE_TAG>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 7777,
          "hostPort": 7777,
          "protocol": "udp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/murang-room-server",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
